# FastAPI
API_TITLE="AutoAgent - AI-Powered Workflow Automation"
API_VERSION="0.1.0"
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False
API_KEY=your-secret-api-key-here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/autoagent
DATABASE_POOL_SIZE=20

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector DB
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=optional-api-key
QDRANT_COLLECTION_NAME=autoagent_documents

# LLM Configuration
LLM_MODEL=mistral-7b
LLM_API_KEY=optional-if-using-mistral-cloud
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_CONFIDENCE_THRESHOLD=0.9

# Embeddings Model
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Gmail API
GMAIL_CREDENTIALS_PATH=./credentials/gmail-credentials.json
GMAIL_TOKEN_PATH=./credentials/gmail-token.json

# Slack API
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# QuickBooks API
QUICKBOOKS_CLIENT_ID=your-quickbooks-client-id
QUICKBOOKS_CLIENT_SECRET=your-quickbooks-client-secret
QUICKBOOKS_REALM_ID=your-quickbooks-realm-id

# BambooHR API
BAMBOOHR_API_KEY=your-bamboohr-api-key
BAMBOOHR_DOMAIN=your-company

# Observability
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO
LOG_FORMAT=json

# Feature Flags
ENABLE_RAG=True
ENABLE_HUMAN_IN_LOOP=True
ENABLE_METRICS=True
ENABLE_TRACING=True

# File Upload
MAX_UPLOAD_SIZE=104857600
ALLOWED_FILE_TYPES=pdf,xlsx,csv,txt,eml
UPLOAD_DIR=./data/uploads

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TIMEOUT=3600

# Rules Engine
RULES_CONFIG_PATH=./configs/rules.yaml
